# CFS Playwright — environment template
#
# Copy this file to .env.<TEST_ENV> (.env.local, .env.dev, .env.uat, .env.production)
# and fill in the sign-in. Those files are gitignored; only this template is committed.
# Real environment variables (CI secrets, the shell) always win over these files.

# Address of the CFS app, including the /CFS base path.
# Defaults per environment are in src/config/environments.ts.
BASE_URL=http://localhost:3000/CFS

# CFS account the signed-in tests use. Use a test user whose roles grant the
# screens under test; a screen the role cannot open is reported as skipped.
CFS_USERNAME=
CFS_PASSWORD=

# Tests that create or change records (tagged @write) run only when true.
# Ignored on production, which is always read-only.
ALLOW_WRITES=false

# Browsers to run the signed-in tests in: chromium, firefox, webkit, msedge, chrome (comma-separated).
BROWSERS=chromium
HEADLESS=true
# Pause between browser actions in ms (useful with HEADLESS=false).
SLOW_MO=0
# Parallel workers. Keep it low against a dev server: every screen runs a role check.
WORKERS=2
RETRIES=0

# Timeouts in ms. After each navigation CFS checks the role's screen access,
# which takes 15–25 s on a dev server (`next dev`) and well under 5 s on a build.
SCREEN_READY_TIMEOUT=45000
TEST_TIMEOUT=90000
EXPECT_TIMEOUT=15000

# Accept self-signed certificates (internal HTTPS hosts).
IGNORE_HTTPS_ERRORS=false

# Open the CFS HTML report after the run: never | on-failure | always
CFS_REPORT_OPEN=never
