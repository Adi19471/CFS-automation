{
  "name": "cfs-office-playwright",
  "version": "1.05.06",
  "private": true,
  "description": "End-to-end UI automation for the CFS (Container Freight Station) web application: Playwright + TypeScript, Page Object Model, fixtures, Allure and a custom CFS HTML report.",
  "scripts": {
    "test": "playwright test",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:production": "cross-env TEST_ENV=production playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep \"@smoke|@sanity|@regression\"",
    "test:local:smoke": "cross-env TEST_ENV=local playwright test --grep @smoke",
    "test:local:sanity": "cross-env TEST_ENV=local playwright test --grep @sanity",
    "test:local:regression": "cross-env TEST_ENV=local playwright test --grep \"@smoke|@sanity|@regression\"",
    "test:dev:smoke": "cross-env TEST_ENV=dev playwright test --grep @smoke",
    "test:dev:sanity": "cross-env TEST_ENV=dev playwright test --grep @sanity",
    "test:dev:regression": "cross-env TEST_ENV=dev playwright test --grep \"@smoke|@sanity|@regression\"",
    "test:uat:smoke": "cross-env TEST_ENV=uat playwright test --grep @smoke",
    "test:uat:sanity": "cross-env TEST_ENV=uat playwright test --grep @sanity",
    "test:uat:regression": "cross-env TEST_ENV=uat playwright test --grep \"@smoke|@sanity|@regression\"",
    "test:production:smoke": "cross-env TEST_ENV=production playwright test --grep @smoke",
    "test:public": "playwright test --project=public",
    "test:auth": "playwright test tests/auth",
    "test:dashboard": "playwright test tests/dashboard",
    "test:navigation": "playwright test tests/navigation",
    "test:settings": "playwright test tests/settings",
    "test:commercial": "playwright test tests/commercial",
    "test:marine": "playwright test tests/marine",
    "test:depot": "playwright test tests/empty-depot",
    "test:operations": "playwright test tests/operations",
    "test:mnr": "playwright test tests/mnr",
    "test:invoice": "playwright test tests/invoice",
    "test:documents": "playwright test tests/documents",
    "test:edi": "playwright test tests/edi",
    "test:admin": "playwright test tests/admin",
    "test:headed": "cross-env HEADLESS=false playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:list": "playwright test --list",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "report:open": "node scripts/open-report.mjs",
    "report:playwright": "playwright show-report playwright-report",
    "sync:screens": "node scripts/sync-screens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node scripts/clean.mjs"
  },
  "keywords": [
    "playwright",
    "cfs",
    "e2e",
    "allure"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3"
  }
}